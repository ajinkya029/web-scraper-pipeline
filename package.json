{
  "name": "mern-web-scraper-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "MERN starter for queued web scraping, normalization, and MongoDB storage",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "nodemon server/src/index.js",
    "server:start": "node server/src/index.js",
    "client:dev": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}